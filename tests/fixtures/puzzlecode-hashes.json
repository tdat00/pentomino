{
  "description": "Structural cases of the single-owner puzzle-hash parser (parsePuzzleHash). ok cases give the once-decoded, unnormalized p and, for the input normalizer, the normalized code or its error; failures give the code: index or invalid. Host parsers for the p route read the same table.",
  "cases": [
    { "hash": "#p=1D0J492G", "ok": true, "p": "1D0J492G", "normalized": "1D0J492G" },
    { "hash": "p=1D0J492G", "ok": true, "p": "1D0J492G", "normalized": "1D0J492G", "note": "no # at all: the whole string is the body" },
    { "hash": "https://tdat00.github.io/pentomino/player/#p=1D0J492G.18V3WE", "ok": true, "p": "1D0J492G.18V3WE", "normalized": "1D0J492G.18V3WE", "note": "whole pasted link; the tail is part of p" },
    { "hash": "#p=1D0J492G&i=0", "ok": true, "p": "1D0J492G", "normalized": "1D0J492G" },
    { "hash": "#i=0&p=1D0J492G", "ok": true, "p": "1D0J492G", "normalized": "1D0J492G", "note": "key order does not matter" },
    { "hash": "#p=1D0J492G&x=1&x=2&utm=a", "ok": true, "p": "1D0J492G", "normalized": "1D0J492G", "note": "unknown keys are ignored, also repeated ones" },
    { "hash": "#p=1D0J492G&&flag", "ok": true, "p": "1D0J492G", "normalized": "1D0J492G", "note": "empty parts and parts without = are unknown keys" },
    { "hash": "#p=1d0j-492g", "ok": true, "p": "1d0j-492g", "normalized": "1D0J492G", "note": "lower case and hyphen grouping are normalizer concerns" },
    { "hash": "#p=1D0J%20492G%0A18V3", "ok": true, "p": "1D0J 492G\n18V3", "normalized": "1D0J492G18V3", "note": "encoded grouping is decoded once, then removed" },
    { "hash": "#p=%31%44%30%4A", "ok": true, "p": "1D0J", "normalized": "1D0J", "note": "encoded symbols are decoded exactly once" },
    { "hash": "#p=1D0J+492G", "ok": true, "p": "1D0J+492G", "normalizeError": "bad-char", "note": "a literal plus is not a space and fails later as bad-char" },
    { "hash": "#p=%2520", "ok": true, "p": "%20", "normalizeError": "bad-char", "note": "twice-encoded: decoded once, never twice; the percent sign fails as bad-char" },
    { "hash": "#p=1D0J%23p%3D1D0J", "ok": true, "p": "1D0J#p=1D0J", "normalizeError": "bad-char", "note": "an encoded # cannot introduce a nested p route" },
    { "hash": "#p=1D0J#p=2222", "ok": true, "p": "1D0J#p=2222", "normalizeError": "bad-char", "note": "only the first # splits; the rest is data" },
    { "hash": "#p=1D0J&i=999999", "ok": false, "code": "index", "note": "largest six-digit index" },
    { "hash": "#p=1D0J&i=1", "ok": false, "code": "index" },
    { "hash": "#p=1D0J&i=1000000", "ok": false, "code": "invalid", "note": "seven digits" },
    { "hash": "#p=1D0J&i=00", "ok": false, "code": "invalid", "note": "leading zero" },
    { "hash": "#p=1D0J&i=01", "ok": false, "code": "invalid" },
    { "hash": "#p=1D0J&i=-1", "ok": false, "code": "invalid" },
    { "hash": "#p=1D0J&i=%31", "ok": false, "code": "invalid", "note": "i is never URI-decoded" },
    { "hash": "#p=1D0J&i=%200", "ok": false, "code": "invalid" },
    { "hash": "#p=1D0J&i=1x", "ok": false, "code": "invalid" },
    { "hash": "#p=1D0J&i=", "ok": false, "code": "invalid", "note": "empty i" },
    { "hash": "#p=1D0J&i=0&i=0", "ok": false, "code": "invalid", "note": "repeated known key" },
    { "hash": "#p=1D0J&p=2222", "ok": false, "code": "invalid", "note": "repeated known key" },
    { "hash": "#p=1D0J&pack=1j.abc", "ok": false, "code": "invalid", "note": "p together with pack" },
    { "hash": "#p=1D0J&lib=0123456789abcdef", "ok": false, "code": "invalid", "note": "p together with lib" },
    { "hash": "#p=", "ok": false, "code": "invalid", "note": "empty p" },
    { "hash": "#p", "ok": false, "code": "invalid", "note": "p without =" },
    { "hash": "#i=0", "ok": false, "code": "invalid", "note": "missing p" },
    { "hash": "#P=1D0J", "ok": false, "code": "invalid", "note": "keys are case-sensitive; P is an unknown key" },
    { "hash": "#pack=1j.abc", "ok": false, "code": "invalid", "note": "a legacy route is not a p route (host parsers handle it first)" },
    { "hash": "", "ok": false, "code": "invalid" },
    { "hash": "#", "ok": false, "code": "invalid" },
    { "hash": "#p=%ZZ", "ok": false, "code": "invalid", "note": "invalid percent escape" },
    { "hash": "#p=%E0%A4%A", "ok": false, "code": "invalid", "note": "truncated escape sequence" },
    { "hash": "#p=%C0%80", "ok": false, "code": "invalid", "note": "overlong UTF-8 is a URIError" },
    { "hash": "#p=%ZZ&i=1", "ok": false, "code": "index", "note": "the index is judged before p is decoded" },
    { "hash": "#p=&i=1", "ok": false, "code": "invalid", "note": "an empty p wins over an index" }
  ]
}
